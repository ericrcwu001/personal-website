{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/learn-smarter-build-carefully", "destination": "/learn-smarter-build-carefully/index.html" },
    { "source": "/projects/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/media/intro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
